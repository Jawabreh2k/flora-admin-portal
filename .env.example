# Flora CMS .NET API base URL (server-only).
FLORA_API_URL=http://localhost:5253

# Public site — used to push instant cache revalidation after a save.
FLORA_PUBLIC_SITE_URL=http://localhost:3000
FLORA_REVALIDATE_SECRET=change-me-to-match-the-public-site

# Public site URL exposed to the browser for the "View site" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API URL for resume links opened from the admin applications table.
NEXT_PUBLIC_FLORA_API_URL=http://localhost:5253
